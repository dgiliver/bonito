#!/bin/bash
# Bonito Bot Startup Script
# This file is generated by GitHub Actions deploy workflow.
# Secrets are fetched from AWS Secrets Manager at runtime — never stored on disk.

set -euo pipefail

cd /home/ec2-user/bonito
source .venv/bin/activate
export PYTHONPATH="/home/ec2-user/bonito/src:${PYTHONPATH:-}"

# Fetch secrets from AWS Secrets Manager (no secrets on disk)
eval $(python3 -c "
import boto3, json
client = boto3.client('secretsmanager', region_name='us-east-1')
secret = json.loads(client.get_secret_value(SecretId='bonito_paper')['SecretString'])
for k, v in secret.items():
    print(f'export {k}=\"{v}\"')
")

# Run the bot with the deployed strategy
exec python3 scripts/run_bot.py --strategy strategies/deployed_strategy.json --mode paper

{
  "name": "ema_cross_basic",
  "description": "Basic EMA crossover strategy - buy when fast EMA crosses above slow EMA",
  "version": "1.0",
  "symbols": ["SPY"],
  "timeframe": "1d",
  "indicators": [
    {
      "type": "ema",
      "name": "fast_ema",
      "params": {"period": 12}
    },
    {
      "type": "ema",
      "name": "slow_ema",
      "params": {"period": 26}
    }
  ],
  "entry_rules": [
    {
      "conditions": [
        {
          "left": "fast_ema",
          "comparison": "crosses_above",
          "right": "slow_ema"
        }
      ],
      "logic": "AND"
    }
  ],
  "exit_rules": [
    {
      "conditions": [
        {
          "left": "fast_ema",
          "comparison": "crosses_below",
          "right": "slow_ema"
        }
      ],
      "logic": "AND"
    }
  ],
  "position_size": {
    "type": "percent_equity",
    "value": 100
  },
  "max_positions": 1,
  "stop_loss": {
    "type": "percent",
    "value": 0.05
  },
  "take_profit": null
}

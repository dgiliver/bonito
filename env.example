# Quant Agent Configuration
# Copy this file to .env and fill in your values

# Required: At least one LLM API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override defaults
# DEFAULT_MODEL=claude-sonnet-4-20250514
# MAX_ITERATIONS=10
# MAX_TOKENS=4096
# DEFAULT_INITIAL_CAPITAL=100000
# DEFAULT_COMMISSION=0.001

# Data directory (default: ./data)
# DATA_DIR=./data

# Alpaca bot-deploy path ("smart trader" surface - separate from the
# Robinhood live-trading pipeline under livetrade/)
# Required to store/load encrypted broker credentials (no default - set
# your own before linking an Alpaca account):
# BONITO_CREDENTIAL_PASSWORD=change-me
# Human-only master switch for real-money Alpaca bot deployment (mode=
# "live"). Off by default; only set this if you intend to deploy live
# Alpaca bots from this environment:
# ALPACA_LIVE_TRADING_ENABLED=true
